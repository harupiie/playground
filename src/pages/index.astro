---
import articlesData from '../data/articles.json';

const { updatedAt, articles } = articlesData;
const sources = ['All', 'OpenAI', 'Claude', 'Cursor'];

const formatDate = (dateStr) => {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleDateString('ja-JP', {
      year: 'numeric', month: 'short', day: 'numeric',
    });
  } catch {
    return dateStr;
  }
};

const sourceColor = {
  OpenAI: 'bg-emerald-100 text-emerald-800',
  Claude: 'bg-purple-100 text-purple-800',
  Cursor: 'bg-blue-100 text-blue-800',
};

const categoryColor = {
  'Codex': 'bg-emerald-50 text-emerald-600',
  'Claude Code': 'bg-purple-50 text-purple-600',
  'Agents': 'bg-violet-50 text-violet-600',
  'Product Announcements': 'bg-orange-50 text-orange-600',
  'Enterprise AI': 'bg-sky-50 text-sky-600',
  'Blog': 'bg-blue-50 text-blue-600',
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Tech Feeds</title>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 py-4 space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-xl font-bold text-gray-900">AI Tech Feeds</h1>
            <p class="text-xs text-gray-400 mt-0.5">
              更新: {formatDate(updatedAt)} · <span id="shown-count">{articles.length}</span> 件
            </p>
          </div>
          <div class="flex gap-2 flex-wrap" id="filter-buttons">
            {sources.map(s => (
              <button
                class={`filter-btn px-3 py-1.5 rounded-full text-sm font-medium transition-colors ${s === 'All' ? 'bg-gray-900 text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'}`}
                data-source={s}
              >
                {s}
              </button>
            ))}
          </div>
        </div>
        <input
          id="search"
          type="search"
          placeholder="記事を検索..."
          class="w-full px-4 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-300 bg-gray-50"
        />
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-6">
      <div id="articles" class="space-y-3">
        {articles.map((article, i) => (
          <article
            class="article-item bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 hover:shadow-sm transition-all"
            data-source={article.source}
            data-link={article.link}
            data-index={i}
            style={i >= 50 ? 'display:none' : ''}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${sourceColor[article.source] ?? 'bg-gray-100 text-gray-600'}`}>
                    {article.source}
                  </span>
                  <span class={`text-xs px-2 py-0.5 rounded-full ${categoryColor[article.category] ?? 'bg-gray-50 text-gray-500'}`}>
                    {article.category}
                  </span>
                </div>
                <a
                  href={article.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block hover:text-blue-600 transition-colors"
                >
                  {article.titleJa ? (
                    <>
                      <span class="text-gray-900 font-medium line-clamp-2">{article.titleJa}</span>
                      <span class="text-xs text-gray-400 line-clamp-1 mt-0.5">{article.title}</span>
                    </>
                  ) : (
                    <span class="text-gray-900 font-medium line-clamp-2">{article.title}</span>
                  )}
                </a>
              </div>
              {article.date && (
                <time class="text-xs text-gray-400 shrink-0 mt-1">
                  {formatDate(article.date)}
                </time>
              )}
            </div>
          </article>
        ))}
      </div>

      <div id="load-more-wrapper" class="mt-6 text-center" style={articles.length <= 50 ? 'display:none' : ''}>
        <button
          id="load-more"
          class="px-6 py-2.5 bg-white border border-gray-200 rounded-lg text-sm text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-colors"
        >
          もっと見る
        </button>
      </div>
    </main>

    <script id="articles-data" type="application/json" set:html={JSON.stringify(articles)}></script>

    <script>
      import Fuse from 'fuse.js';

      const articles = JSON.parse(document.getElementById('articles-data')!.textContent!);
      const fuse = new Fuse(articles, {
        keys: ['titleJa', 'title'],
        threshold: 0.4,
        ignoreLocation: true,
      });

      const items = Array.from(document.querySelectorAll<HTMLElement>('.article-item'));
      const shownCountEl = document.getElementById('shown-count')!;
      const loadMoreWrapper = document.getElementById('load-more-wrapper')!;
      const loadMoreBtn = document.getElementById('load-more')!;

      const PAGE_SIZE = 50;
      let currentSource = 'All';
      let currentSearch = '';
      let visibleCount = PAGE_SIZE;

      function getVisibleItems(): HTMLElement[] {
        if (currentSearch) {
          const matchLinks = new Set(fuse.search(currentSearch).map((r: any) => r.item.link));
          return items.filter(item => {
            const sourceMatch = currentSource === 'All' || item.dataset.source === currentSource;
            return sourceMatch && matchLinks.has(item.dataset.link);
          });
        }
        return items.filter(item =>
          currentSource === 'All' || item.dataset.source === currentSource
        );
      }

      function update() {
        const visible = getVisibleItems();

        items.forEach(item => { item.style.display = 'none'; });

        const toShow = currentSearch ? visible : visible.slice(0, visibleCount);
        toShow.forEach(item => { item.style.display = ''; });

        shownCountEl.textContent = String(toShow.length);
        loadMoreWrapper.style.display = (!currentSearch && visible.length > visibleCount) ? '' : 'none';
      }

      // ソースフィルター
      document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentSource = btn.dataset.source!;
          visibleCount = PAGE_SIZE;

          document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('bg-gray-900', 'text-white');
            b.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
          });
          btn.classList.add('bg-gray-900', 'text-white');
          btn.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');

          update();
        });
      });

      // 検索
      document.getElementById('search')!.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.trim();
        visibleCount = PAGE_SIZE;
        update();
      });

      // もっと見る
      loadMoreBtn.addEventListener('click', () => {
        visibleCount += PAGE_SIZE;
        update();
      });
    </script>
  </body>
</html>
